  },
  "homepage": "https://github.com/brijeshyadav2312/responsive-audit",
  "bugs": {
    "url": "https://github.com/brijeshyadav2312/responsive-audit/issues"
  },
  "keywords": [
    "agent-skills",
    "agent-skill",
    "responsive-ui",
    "responsive-ui-skill",
    "responsive-agent-skill",
    "responsive-design",
    "responsive-layout",
    "responsive-page",
    "ui-responsiveness",
    "responsive-audit",
    "responsive-audit-report",
    "ui-responsive-report",
    "responsive-testing",
    "breakpoint-testing",
    "device-emulation",
    "playwright",
    "browser-automation",
    "mobile-testing",
    "tablet-testing",
    "foldable",
    "tv-testing",
    "safe-area",
    "tap-targets",
    "web-development",
    "qa",
    "cli"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "responsive-audit": "./scripts/cli.mjs"
  },
  "files": [
    "SKILL.md",
    "scripts/",
    "references/",
    "evals/",
    "demo/"
  ],
  "scripts": {
    "audit": "node scripts/cli.mjs",
    "demo": "node scripts/cli.mjs demo/index.html --full",
    "demo:devices": "node scripts/cli.mjs demo/index.html --mode devices --devices mobile --shots all",
    "audit:full": "node scripts/cli.mjs demo/index.html --mode all --shots all",
    "devices": "node scripts/cli.mjs --list-devices",
    "validate": "node scripts/validate-skill.mjs",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm run validate && npm test",
    "start": "node scripts/cli.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "playwright": "^1.64.1"
  }
}

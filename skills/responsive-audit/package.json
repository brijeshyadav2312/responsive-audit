{
  "name": "responsive-audit",
  "version": "0.2.0",
  "type": "module",
  "description": "Agent skill + CLI that audits UI responsiveness at breakpoint edges and across device profiles using deterministic DOM evidence.",
  "license": "MIT",
  "author": {
    "name": "Brijesh Yadav",
    "email": "88343913+brijeshyadav2312@users.noreply.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brijeshyadav2312/responsive-audit.git",
    "directory": "skills/responsive-audit"
  },
  "homepage": "https://github.com/brijeshyadav2312/responsive-audit",
  "bugs": {
    "url": "https://github.com/brijeshyadav2312/responsive-audit/issues"
  },
  "keywords": [
    "agent-skills",
    "responsive-design",
    "responsive-layout",
    "breakpoints",
    "playwright",
    "browser-automation",
    "web-development",
    "qa"
  ],
  "bin": {
    "responsive-audit": "./scripts/cli.mjs"
  },
  "files": [
    "SKILL.md",
    "scripts/",
    "references/",
    "evals/",
    "demo/"
  ],
  "scripts": {
    "audit": "node scripts/cli.mjs",
    "demo": "node scripts/cli.mjs demo/index.html --full",
    "demo:devices": "node scripts/cli.mjs demo/index.html --mode devices --devices mobile --shots all",
    "audit:full": "node scripts/cli.mjs demo/index.html --mode all --shots all",
    "devices": "node scripts/cli.mjs --list-devices",
    "validate": "node scripts/validate-skill.mjs",
    "test": "node --test test/*.test.mjs",
    "start": "node scripts/cli.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "playwright": "^1.64.1"
  }
}

{
  "name": "responsive-audit-repo",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Responsive UI agent skill and deterministic CLI that audits responsive pages at breakpoint edges across phone, tablet, foldable, laptop, desktop, and TV profiles.",
  "license": "MIT",
  "keywords": [
    "responsive-design",
    "responsive-ui",
    "responsive-layout",
    "responsive-page",
    "ui-responsiveness",
    "responsive-audit",
    "responsive-audit-report",
    "ui-responsive-report",
    "agent-skill",
    "agent-skills",
    "ai-agent",
    "playwright",
    "breakpoint-testing",
    "device-emulation",
    "mobile-testing",
    "tablet-testing",
    "foldable",
    "tv",
    "qa",
    "cli",
    "web-development"
  ],
  "author": {
    "name": "Brijesh Yadav",
    "email": "88343913+brijeshyadav2312@users.noreply.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brijeshyadav2312/responsive-audit.git"
  },
  "homepage": "https://github.com/brijeshyadav2312/responsive-audit",
  "bugs": {
    "url": "https://github.com/brijeshyadav2312/responsive-audit/issues"
  },
  "workspaces": [
    "skills/responsive-audit"
  ],
  "scripts": {
    "audit": "node skills/responsive-audit/scripts/cli.mjs",
    "demo": "node skills/responsive-audit/scripts/cli.mjs skills/responsive-audit/demo/index.html --full",
    "demo:devices": "node skills/responsive-audit/scripts/cli.mjs skills/responsive-audit/demo/index.html --mode devices --devices mobile --shots all",
    "audit:full": "node skills/responsive-audit/scripts/cli.mjs skills/responsive-audit/demo/index.html --mode all --shots all",
    "devices": "node skills/responsive-audit/scripts/cli.mjs --list-devices",
    "validate": "npm --workspace responsive-audit run validate",
    "validate:skill": "npx --yes skills-ref validate skills/responsive-audit",
    "test": "npm --workspace responsive-audit test",
    "pack:skill": "npm pack --workspace responsive-audit --dry-run",
    "publish:skill": "npm publish --workspace responsive-audit --access public",
    "start": "node skills/responsive-audit/scripts/cli.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
